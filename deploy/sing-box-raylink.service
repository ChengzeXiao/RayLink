[Unit]
Description=sing-box managed by RayLink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/raylink-sing-box run -c /var/lib/raylink/sing-box/config.json
Restart=on-failure
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=raylink/acme
StateDirectoryMode=0700
ReadWritePaths=/var/lib/raylink/acme
ReadOnlyPaths=/var/lib/raylink/sing-box/config.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
