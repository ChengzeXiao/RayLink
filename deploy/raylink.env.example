NODE_ENV=production
RAYLINK_HOST=127.0.0.1
RAYLINK_PORT=4173
RAYLINK_PUBLIC_ORIGIN=https://panel.example.com
RAYLINK_SUBSCRIPTION_ORIGIN=https://sub.example.com
RAYLINK_TRUST_PROXY=true
RAYLINK_ADMIN_USERNAME=admin
RAYLINK_ADMIN_PASSWORD=replace-with-a-long-random-secret
RAYLINK_SUBSCRIPTION_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
RAYLINK_DATA_DIR=/var/lib/raylink
RAYLINK_BBR_CONFIG=/var/lib/raylink/managed/99-raylink-bbr.conf
RAYLINK_PROXY_HOST=node.example.com
RAYLINK_LOCAL_HOST_DIAL_ADDRESS=203.0.113.10
RAYLINK_ENDPOINT_DNS_SERVERS=1.1.1.1,8.8.8.8
RAYLINK_ENDPOINT_DNS_TIMEOUT_MS=2000
RAYLINK_ENDPOINT_PROBE_TIMEOUT_MS=1500
RAYLINK_PROXY_PORT=8388
RAYLINK_RUNTIME_MODE=systemd
# Runtime outbound DNS only; leaves the Host's system DNS untouched.
# auto uses verified DoH with primary/secondary fallback. Use system for custom split DNS.
RAYLINK_RUNTIME_DNS_MODE=auto
RAYLINK_RUNTIME_DNS_PRIMARY=1.1.1.1
RAYLINK_RUNTIME_DNS_PRIMARY_SERVER_NAME=cloudflare-dns.com
RAYLINK_RUNTIME_DNS_SECONDARY=9.9.9.9
RAYLINK_RUNTIME_DNS_SECONDARY_SERVER_NAME=dns.quad9.net
# Additional comma-separated private zones use system DNS and never public fallback.
RAYLINK_RUNTIME_DNS_PRIVATE_SUFFIXES=
# Inspect managed certificate renewal every 15 minutes; 0 disables the schedule.
RAYLINK_TLS_RENEWAL_INTERVAL_MS=900000
RAYLINK_USER_METERING=true
RAYLINK_PROTOCOL_PROBE_URL=https://www.gstatic.com/generate_204
RAYLINK_CADDY_BIN=/usr/bin/caddy
RAYLINK_CADDYFILE=/var/lib/raylink/managed/Caddyfile
RAYLINK_ENV_FILE=/var/lib/raylink/managed/raylink.env
RAYLINK_CONTROL_CERT=/etc/caddy/raylink/control-plane.crt
RAYLINK_CONTROL_KEY=/etc/caddy/raylink/control-plane.key
SING_BOX_BIN=/usr/local/bin/raylink-sing-box
SING_BOX_SYSTEMD_UNIT=sing-box-raylink.service

# 仅新安装首次启动使用。已有实例保持 false；一次性令牌只能保存 SHA-256 base64url 哈希。
RAYLINK_SETUP_REQUIRED=false
# RAYLINK_SETUP_TOKEN_HASH=
# RAYLINK_SETUP_TOKEN_EXPIRES_AT=
# Optional maintainer-approved local rule-set manifest; retain bundled baseline on failure.
# RAYLINK_RULE_SET_MANIFEST=/var/lib/raylink/approved-rules/manifest.json
